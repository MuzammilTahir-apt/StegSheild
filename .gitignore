# ==========================================
# StegShield - Git Ignore
# ==========================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environment
venv/
.venv/
env/
ENV/

# Environment Variables
.env
.env.*

# Flask
instance/
.webassets-cache/

# Uploaded files
uploads/*
!uploads/.gitkeep

# Generated reports
reports/generated/
reports/*.pdf

# Model/cache files
*.joblib
*.pkl
*.pickle
*.h5
*.keras
*.pth
*.pt

# Training outputs
checkpoints/
runs/
logs/
tensorboard/
wandb/

# Dataset
dataset/
datasets/

# Jupyter Notebook
.ipynb_checkpoints/

# IDE / Editors
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.log

# Python testing
.pytest_cache/
.coverage
htmlcov/

# Build files
build/
dist/
*.egg-info/

# Node (if used)
node_modules/

# Local configuration
config.local.*